# Privy app id — enables "Continue with Google" (embedded wallet) and the
# Privy wallet modal. Create one free at https://dashboard.privy.io
# Without it, the app falls back to browser wallets (MetaMask, Rabby…).
VITE_PRIVY_APP_ID=

# Production URLs. Leave empty locally: the app is served at /app.
# Landing on https://<domain>, app on https://app.<domain>
VITE_APP_URL=
VITE_SITE_URL=
